# Production memory (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Development cross-process persistence
SRO_8BALL_MEMORY_FILE=.local/sro-8ball-memory.json

# Approved production response bank. Test-only fixtures are never allowed in production.
SRO_8BALL_RESPONSE_FILE=

# 7TV
SEVENTV_SET_ID=01GBAYMGX0000B23ECE97RP321
SEVENTV_API_BASE=https://api.7tv.app/v3/emote-sets
SEVENTV_CACHE_SECONDS=300
SEVENTV_FETCH_TIMEOUT_MS=3500
# Optional comma-separated test override. Leave empty in production.
SEVENTV_EMOTES=
DISABLE_7TV_FETCH=0

# Debug JSON is disabled in production regardless of this setting.
SRO_8BALL_DEBUG=0

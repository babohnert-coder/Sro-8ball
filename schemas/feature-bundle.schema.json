{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sro-8ball.local/schema/feature-bundle.schema.json",
  "title": "SRO 8 Ball recognition feature bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw",
    "normalized",
    "intent",
    "route_family",
    "domains",
    "entities",
    "concepts",
    "states",
    "specificity",
    "confidence",
    "ambiguities",
    "evidence"
  ],
  "properties": {
    "raw": {
      "type": "string"
    },
    "normalized": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "score"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value",
          "surface",
          "confidence",
          "resolution_status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "resolution_status": {
            "enum": [
              "verified",
              "candidate",
              "unknown"
            ]
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "specificity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_family": {
      "type": "string",
      "minLength": 1
    }
  }
}

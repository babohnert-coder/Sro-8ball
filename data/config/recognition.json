{
  "version": "4.8.0",
  "specificity_formula": {
    "base": 0.05,
    "explicit_intent": 0.1,
    "explicit_domain": 0.15,
    "verified_entity_each": 0.15,
    "exact_multiword_concept_each": 0.2,
    "explicit_state": 0.1,
    "numeric_detail": 0.1,
    "verified_callback": 0.1,
    "ambiguity_each": -0.15,
    "caps": {
      "entity_total": 0.25,
      "concept_total": 0.4,
      "ambiguity_total": -0.3,
      "minimum": 0.05,
      "maximum": 1.0
    }
  },
  "confidence_formula": {
    "base": 0.2,
    "strong_intent_pattern": 0.2,
    "strong_domain_evidence": 0.15,
    "verified_entity": 0.15,
    "exact_multiword_concept": 0.25,
    "supporting_secondary_signal": 0.1,
    "ambiguity_each": -0.15,
    "unresolved_reference": -0.2,
    "minimum": 0.0,
    "maximum": 1.0

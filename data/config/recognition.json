      "doctor",
      "hospital",
      "hurt myself",
      "debt",
      "eviction",
      "emergency"
    ],
    "explicit_serious_patterns": [
      "seriously",
      "real answer",
      "no joke",
      "be serious"
    ],
    "effect": "add serious state and forbid chaos"
  }
}

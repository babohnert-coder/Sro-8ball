{
  "version": "4.0.0",
  "states": [
    {
      "id": "positive_event"
    },
    {
      "id": "negative_event"
    },
    {
      "id": "uncertain"
    },
    {
      "id": "mixed"
    },
    {
      "id": "likely"
    },
    {
      "id": "unlikely"
    },
    {
      "id": "reversible"
    },
    {
      "id": "already_decided"
    },
    {
      "id": "ahead"
    },
    {
      "id": "behind"
    },
    {
      "id": "comeback_possible"
    },
    {
      "id": "throw_risk"
    },
    {
      "id": "serious"
    },
    {
      "id": "sarcastic_or_cope"
    }
  ],
  "inference_rules": [
    {
      "if_concept": "shutdown_given",
      "add": [
        "negative_event",
        "reversible"
      ],
      "never_add": [
        "already_decided"
      ]
    },
    {
      "if_concept": "shutdown_collected",
      "add": [
        "positive_event"
      ]
    },
    {
      "if_concept": "game_over_question",
      "add": [
        "negative_event"
      ],
      "never_add": [
        "already_decided"
      ]
    },
    {
      "if_concept": "comeback_possible",
      "add": [
        "reversible",
        "comeback_possible"
      ]
    },
    {
      "if_concept": "throw_risk",
      "add": [
        "negative_event",
        "throw_risk"
      ]
    },
    {
      "if_concept": "serious_direct",
      "add": [
        "serious"
      ]
    }
  ]
}

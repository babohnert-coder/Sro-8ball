{
  "version": "5.0.0",
  "modes": [
    {
      "id": "classic",
      "description": "Pure or nearly pure Magic 8 Ball wording.",
      "max_league_intensity": 0
    },
    {
      "id": "direct",
      "description": "Serious, concise answer with no performance.",
      "max_league_intensity": 1
    },
    {
      "id": "contextual",
      "description": "One precise supported contextual detail.",
      "max_league_intensity": 2
    },
    {
      "id": "dry",
      "description": "Understated reversal or compact room-aware observation.",
      "max_league_intensity": 2
    },
    {
      "id": "room_lore",
      "description": "Verified SRO room reference, explicitly earned.",
      "max_league_intensity": 2
    },
    {
      "id": "chaos",
      "description": "Rare, readable, lightly absurd answer.",
      "max_league_intensity": 1
    }
  ],
  "soft_target_distribution": {
    "classic_or_direct": 0.4,
    "contextual": 0.3,
    "dry": 0.15,
    "room_lore": 0.05,
    "chaos": 0.1
  },
  "chaos_eligibility": {
    "schedule_min_interval": 10,
    "schedule_max_interval": 15,
    "forbid_consecutive": true,
    "min_recognition_confidence": 0.65,
    "max_specificity": 0.4,
    "forbidden_states": [
      "serious"
    ],
    "forbidden_domains": [
      "work_money"
    ],
    "forbidden_if_named_person_unresolved": true,
    "never_low_confidence_fallback": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sro-8ball-rng",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "RNG",
        "class_name": "RngMachine"
      }
    ]
  },
  "exports": {
    "RngMachine": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
